# ==========================================
# DATABASE & INFRASTRUCTURE
# ==========================================
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/kondapi_connect?schema=public"
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development" # Set to "production" in live environments

# ==========================================
# DISTRIBUTED CACHE & MESSAGE BROKER (REDIS)
# ==========================================
# Optional in dev (falls back to memory), REQUIRED in multi-instance cluster
REDIS_URL="redis://localhost:6379"

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
JWT_SECRET="your-super-secure-jwt-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your-super-secure-refresh-jwt-secret-key-at-least-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="your-super-secure-cookie-secret-at-least-32-chars"
OTP_SECRET="your-super-secure-otp-secret-key-at-least-32-chars-long"
CORS_ORIGIN="http://localhost:3000"

# ==========================================
# FAST2SMS SMART OTP — WHATSAPP LOGIN
# ==========================================
# Create an OTP ID in Fast2SMS Smart OTP and configure it as WhatsApp-first.
# Keep these values ONLY on the backend/server. Never expose them in Vite/React env.
SMS_PROVIDER="fast2sms"
FAST2SMS_API_KEY="your-fast2sms-api-authorization-key"
FAST2SMS_OTP_ID="your-fast2sms-smart-otp-id"
FAST2SMS_OTP_EXPIRY_MINUTES=5

# ==========================================
# AI & ANALYTICS (GOOGLE GEMINI)
# ==========================================
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
